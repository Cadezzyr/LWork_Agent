# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# 所有配置项均通过 AGENT_ 前缀的环境变量覆盖
# ============================================================

# ---------- 应用基础 ----------
AGENT_APP_NAME=LangChain Agent API
AGENT_ENV=dev
AGENT_VERSION=0.1.0
AGENT_LOG_LEVEL=INFO
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_API_PREFIX=/api/v1
# 逗号分隔；生产环境请收敛为真实域名，例如 http://localhost:5173
AGENT_CORS_ORIGINS=*

# ---------- 数据库（登录态 + 对话历史）----------
# PostgreSQL；建表脚本见 docs/db/schema.postgres.sql
# 留空则回退到内存存储：登录功能仍可用，但重启后账号与历史全部丢失。
AGENT_DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/agent_chat
# 连接池水位与连接超时（秒）
AGENT_DB_POOL_MIN=1
AGENT_DB_POOL_MAX=10
AGENT_DB_CONNECT_TIMEOUT=5

# ---------- 认证（登录）----------
# 关闭后 /chat、/sessions 不再校验登录态（仍按匿名账号隔离历史），仅供本地调试
AGENT_AUTH_REQUIRED=true
# 是否开放自助注册；关闭后只能由管理员在库里建账号
AGENT_AUTH_ALLOW_REGISTER=true
# 逗号分隔：这些用户名注册时直接获得 admin 角色（用于开通第一个管理员）
AGENT_AUTH_ADMIN_USERNAMES=
# JWT 签名密钥：务必设置成一段足够长的随机串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
# 留空会使用进程级随机密钥，服务重启后所有登录态失效。
AGENT_JWT_SECRET=please-change-me-to-a-long-random-string
# access token 有效期（分钟）与 refresh token 有效期（天）
AGENT_ACCESS_TOKEN_TTL_MINUTES=60
AGENT_REFRESH_TOKEN_TTL_DAYS=30
# 注册时的密码长度限制
AGENT_PASSWORD_MIN_LENGTH=8
AGENT_PASSWORD_MAX_LENGTH=128

# ---------- 模型（LLM）----------
# provider 可选：openai | anthropic | deepseek | mock
#   openai    : 任意 OpenAI 兼容接口（OpenAI / DeepSeek / Qwen / vLLM / Ollama ...）
#   anthropic : Claude 系列（需额外安装 langchain-anthropic）
#   deepseek  : DeepSeek 官方适配（需 langchain-deepseek，requirements.txt 已包含 1.0.1）
#   mock      : 本地假模型，无需 API Key，用于联调与自动化测试
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini
# 没有 Key 时留空，/health/ready 会提示未就绪
AGENT_API_KEY=
# 使用 DeepSeek 官方适配时示例：
#   AGENT_PROVIDER=deepseek
#   AGENT_MODEL=deepseek-chat
#   AGENT_API_KEY=sk-xxx
# 也可走 OpenAI 兼容协议：
#   AGENT_PROVIDER=openai
#   AGENT_MODEL=deepseek-chat
#   AGENT_BASE_URL=https://api.deepseek.com/v1
# 使用本地 Ollama 时示例：
#   AGENT_MODEL=qwen2.5:7b
#   AGENT_BASE_URL=http://localhost:11434/v1
#   AGENT_API_KEY=ollama
AGENT_BASE_URL=
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2048
AGENT_REQUEST_TIMEOUT=60
AGENT_MAX_RETRIES=2

# ---------- 智能体（Agent）----------
AGENT_AGENT_NAME=assistant
# 留空则使用 app/agent/prompt.py 中的默认提示词
AGENT_SYSTEM_PROMPT=
# 启用的工具，逗号分隔；留空表示注册全部工具
# 工作区文件：list/read/search/write/edit/delete_workspace_file（根目录在页面里设置，不在这里配）
# 联网：web_search / fetch_web_page
AGENT_ENABLED_TOOLS=calculator,get_current_time,search_knowledge_base,list_workspace_files,read_workspace_file,search_workspace,write_workspace_file,edit_workspace_file,delete_workspace_file,web_search,fetch_web_page,run_command,run_python
# 单次请求允许的最大工具调用轮数（识别死循环）
AGENT_MAX_TOOL_ROUNDS=8
# 会话内存上限（每个会话保留的消息条数，超出后不再对外返回全量历史）
AGENT_MAX_SESSIONS=1000

# ---------- 联网检索 ----------
# auto: 配了 AGENT_SEARCH_API_KEY 就用 tavily，否则抓 bing 结果页（不需要 key）
# 可选值：auto | bing | duckduckgo | tavily
AGENT_SEARCH_PROVIDER=auto
# Tavily 等服务商的 Key；留空则使用免 key 的 Bing 抓取
AGENT_SEARCH_API_KEY=
AGENT_WEB_TIMEOUT=25
AGENT_WEB_MAX_CHARS=4000

# ---------- 工作区 ----------
# 注意：工作区根目录 **不在配置文件里设置**，请在前端页面点右上角「工作区」设置，
# 或调用 PUT /api/v1/workspace；进程重启后回到默认值（项目根目录）。
# 内存态的写权限开关同样由页面控制（默认开启）。
# 注意：终端工具（run_command / run_python）与写权限共用同一个开关，
# 关掉写权限后终端能力也会被禁用。

# ---------- 终端工具 ----------
# 单条命令默认超时（秒），单次调用可覆盖，上限 120
AGENT_SHELL_TIMEOUT=30
# 回传给模型的最大输出字符数
AGENT_SHELL_MAX_OUTPUT=8000
# 命令白名单（逗号分隔）：留空=黑名单模式（只拦危险命令）
# 想更安全就写死允许的命令，例如：git,python,pytest,dir,ls,cat,type
AGENT_SHELL_ALLOWLIST=
